# Deer (DaeNext / daed) UCI 配置
#
# 自启开关不在这里：由 /etc/rc.d/S95deer 软链决定（LuCI「开机自启」=
# /etc/init.d/deer enable|disable）。init 刻意不读 UCI enabled，避免
# LuCI「启动」按钮被静默拦掉。
#
# 代理规则 / 节点 / 订阅在 daed 面板里配置（http://<路由器>:<listen>/），
# 不在本文件里 —— daed 的配置实体存在 daed.db（SQLite）中。

config deer 'main'
	# daed 配置目录（也存放 daed.db、输入配置快照、geodata 解析缓存）
	option config_dir '/etc/deer'
	# 产品状态库；留空/缺省即 $config_dir/daed.db
	option state '/etc/deer/daed.db'
	# 控制面监听（REST API + Web UI）；改成 127.0.0.1:2023 可只允许本机访问
	option listen '0.0.0.0:2023'
	# Web UI 根目录（geodata 必须放在它的父目录 /usr/share/deer/）
	option web_root '/usr/share/deer/web'
	# 产品日志目录（JSONL: current.jsonl）
	option log_dir '/tmp/log/deer'
	# HTTP worker 档位：low-memory / balanced / performance
	option http_profile 'low-memory'
	# 1=只跑控制面（不加载 eBPF 数据面），用于纯管理/调试
	option api_only '0'
	# 启动前 `daed validate -c <config_dir>`（新装空目录也能通过）
	option validate_start '1'
	# 重载前 `daed validate --runtime`（失败则拒绝重载，保留旧配置）
	option validate_reload '1'
	# 1=把 /tmp/resolv.conf 劫持到 daed DNS（默认关闭：配置不当会导致全机解析失败）
	option hijack_resolv '0'
	option respawn '1'
	option term_timeout '10'
	option nofile '1048576'
	option nproc '512'
